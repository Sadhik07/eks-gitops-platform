{
  "title": "DORA Metrics - Production",
  "uid": "dora-prod",
  "schemaVersion": 39,
  "time": { "from": "now-30d", "to": "now" },
  "refresh": "15m",
  "tags": ["dora", "delivery"],
  "panels": [
    {
      "type": "stat", "title": "Deployment frequency", "gridPos": { "x": 0, "y": 0, "w": 6, "h": 6 },
      "description": "Production deployments per day, rolling 30 days. Elite: on demand (>= 1/day).",
      "fieldConfig": { "defaults": { "unit": "none", "decimals": 2, "displayName": "deploys / day" } },
      "targets": [{ "expr": "dora_deployment_frequency_per_day{environment=\"prod\"}" }]
    },
    {
      "type": "stat", "title": "Lead time for changes (median)", "gridPos": { "x": 6, "y": 0, "w": 6, "h": 6 },
      "description": "Commit of the deployed image -> production. Elite: < 1 day.",
      "fieldConfig": { "defaults": { "unit": "s",
        "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "orange", "value": 86400 }, { "color": "red", "value": 604800 }] } } },
      "targets": [{ "expr": "dora_lead_time_seconds_median{environment=\"prod\"}" }]
    },
    {
      "type": "stat", "title": "Change failure rate", "gridPos": { "x": 12, "y": 0, "w": 6, "h": 6 },
      "description": "Deployments followed by a rollback or an incident within 24h.",
      "fieldConfig": { "defaults": { "unit": "percentunit",
        "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "orange", "value": 0.15 }, { "color": "red", "value": 0.3 }] } } },
      "targets": [{ "expr": "dora_change_failure_rate{environment=\"prod\"}" }]
    },
    {
      "type": "stat", "title": "Time to restore (median)", "gridPos": { "x": 18, "y": 0, "w": 6, "h": 6 },
      "description": "Incident issue opened -> closed. Elite: < 1 hour.",
      "fieldConfig": { "defaults": { "unit": "s",
        "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "orange", "value": 3600 }, { "color": "red", "value": 86400 }] } } },
      "targets": [{ "expr": "dora_time_to_restore_seconds_median{environment=\"prod\"}" }]
    },
    {
      "type": "timeseries", "title": "Deployment frequency trend", "gridPos": { "x": 0, "y": 6, "w": 12, "h": 8 },
      "targets": [{ "expr": "dora_deployment_frequency_per_day{environment=\"prod\"}", "legendFormat": "deploys/day" }]
    },
    {
      "type": "timeseries", "title": "Change failure rate trend", "gridPos": { "x": 12, "y": 6, "w": 12, "h": 8 },
      "fieldConfig": { "defaults": { "unit": "percentunit" } },
      "targets": [{ "expr": "dora_change_failure_rate{environment=\"prod\"}", "legendFormat": "CFR" }]
    }
  ]
}
