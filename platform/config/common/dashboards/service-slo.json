{
  "title": "Orders API - SLO & Golden Signals",
  "uid": "orders-api-slo",
  "schemaVersion": 39,
  "time": { "from": "now-6h", "to": "now" },
  "refresh": "30s",
  "tags": ["orders", "slo"],
  "panels": [
    {
      "type": "stat", "title": "Availability (30d)", "gridPos": { "x": 0, "y": 0, "w": 6, "h": 5 },
      "fieldConfig": { "defaults": { "unit": "percentunit", "decimals": 3,
        "thresholds": { "mode": "absolute", "steps": [{ "color": "red", "value": null }, { "color": "green", "value": 0.995 }] } } },
      "targets": [{ "expr": "1 - (sum(increase(http_requests_total{service=\"api\",code=~\"5..\"}[30d])) / sum(increase(http_requests_total{service=\"api\"}[30d])))" }]
    },
    {
      "type": "stat", "title": "Error budget remaining (30d)", "gridPos": { "x": 6, "y": 0, "w": 6, "h": 5 },
      "fieldConfig": { "defaults": { "unit": "percentunit", "min": 0, "max": 1,
        "thresholds": { "mode": "absolute", "steps": [{ "color": "red", "value": null }, { "color": "orange", "value": 0.25 }, { "color": "green", "value": 0.5 }] } } },
      "targets": [{ "expr": "1 - ((sum(increase(http_requests_total{service=\"api\",code=~\"5..\"}[30d])) / sum(increase(http_requests_total{service=\"api\"}[30d]))) / 0.005)" }]
    },
    {
      "type": "stat", "title": "Burn rate (1h)", "gridPos": { "x": 12, "y": 0, "w": 6, "h": 5 },
      "fieldConfig": { "defaults": { "decimals": 2,
        "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "orange", "value": 6 }, { "color": "red", "value": 14.4 }] } } },
      "targets": [{ "expr": "slo:api_errors:ratio_rate1h / 0.005" }]
    },
    {
      "type": "stat", "title": "Active canaries", "gridPos": { "x": 18, "y": 0, "w": 6, "h": 5 },
      "targets": [{ "expr": "count(rollout_info{phase=\"Progressing\"}) or vector(0)" }]
    },
    {
      "type": "timeseries", "title": "Request rate by status", "gridPos": { "x": 0, "y": 5, "w": 12, "h": 8 },
      "fieldConfig": { "defaults": { "unit": "reqps" } },
      "targets": [{ "expr": "sum by (code) (rate(http_requests_total{service=\"api\"}[5m]))", "legendFormat": "{{code}}" }]
    },
    {
      "type": "timeseries", "title": "Error ratio: stable vs canary", "gridPos": { "x": 12, "y": 5, "w": 12, "h": 8 },
      "fieldConfig": { "defaults": { "unit": "percentunit" } },
      "targets": [{ "expr": "sum by (rollouts_pod_template_hash) (rate(http_requests_total{service=\"api\",code=~\"5..\"}[1m])) / sum by (rollouts_pod_template_hash) (rate(http_requests_total{service=\"api\"}[1m]))", "legendFormat": "{{rollouts_pod_template_hash}}" }]
    },
    {
      "type": "timeseries", "title": "Latency p50 / p95 / p99", "gridPos": { "x": 0, "y": 13, "w": 12, "h": 8 },
      "fieldConfig": { "defaults": { "unit": "s" } },
      "targets": [
        { "expr": "histogram_quantile(0.50, sum by (le) (rate(http_request_duration_seconds_bucket{service=\"api\"}[5m])))", "legendFormat": "p50" },
        { "expr": "histogram_quantile(0.95, sum by (le) (rate(http_request_duration_seconds_bucket{service=\"api\"}[5m])))", "legendFormat": "p95" },
        { "expr": "histogram_quantile(0.99, sum by (le) (rate(http_request_duration_seconds_bucket{service=\"api\"}[5m])))", "legendFormat": "p99" }
      ]
    },
    {
      "type": "timeseries", "title": "Worker: queue age and failures", "gridPos": { "x": 12, "y": 13, "w": 12, "h": 8 },
      "targets": [
        { "expr": "max(worker_oldest_message_age_seconds)", "legendFormat": "oldest message age (s)" },
        { "expr": "sum(rate(worker_messages_processed_total{result=\"error\"}[5m]))", "legendFormat": "failures/s" }
      ]
    }
  ]
}
